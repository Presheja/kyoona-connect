# Copy this file to .env (locally) or add these in Hostinger hPanel → Node.js app → Environment variables.

# The site's public address (used in email links)
SITE_URL=https://kyoonaconnect.com

# Admin page (/admin) password — make it long
ADMIN_PASSWORD=change-me-to-something-long
# Any long random string; keeps admin logins secure
SESSION_SECRET=paste-a-long-random-string-here

# Shown on the site and used for test emails
CONTACT_EMAIL=hello@kyoonaconnect.com

# Hostinger MySQL (hPanel → Databases). Leave DB_HOST empty to store members in a local file instead.
DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# Hostinger email SMTP (hPanel → Emails). Leave SMTP_HOST empty to print emails to the log instead.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=hello@kyoonaconnect.com
SMTP_PASSWORD=
MAIL_FROM=Kyoona Connect <hello@kyoonaconnect.com>
