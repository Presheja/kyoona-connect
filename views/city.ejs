<%- include('partials/head') %>
<%- include('partials/header') %>
<%
  const CAT = { community: 'Association', faith: 'Church & fellowship', food: 'Food & business', groups: 'Group' };
  const cats = [['community', 'Associations'], ['faith', 'Churches'], ['food', 'Food']].filter(([k]) => dir.listings.some(l => l.category === k));
  const STATES = { AL:'Alabama',AK:'Alaska',AZ:'Arizona',AR:'Arkansas',CA:'California',CO:'Colorado',CT:'Connecticut',DE:'Delaware',DC:'Washington DC',FL:'Florida',GA:'Georgia',HI:'Hawaii',ID:'Idaho',IL:'Illinois',IN:'Indiana',IA:'Iowa',KS:'Kansas',KY:'Kentucky',LA:'Louisiana',ME:'Maine',MD:'Maryland',MA:'Massachusetts',MI:'Michigan',MN:'Minnesota',MS:'Mississippi',MO:'Missouri',MT:'Montana',NE:'Nebraska',NV:'Nevada',NH:'New Hampshire',NJ:'New Jersey',NM:'New Mexico',NY:'New York',NC:'North Carolina',ND:'North Dakota',OH:'Ohio',OK:'Oklahoma',OR:'Oregon',PA:'Pennsylvania',RI:'Rhode Island',SC:'South Carolina',SD:'South Dakota',TN:'Tennessee',TX:'Texas',UT:'Utah',VT:'Vermont',VA:'Virginia',WA:'Washington',WV:'West Virginia',WI:'Wisconsin',WY:'Wyoming' };
%>
<main>
  <section class="org-hero">
    <div class="shell">
      <p class="eyebrow">Find your people</p>
      <h1 class="org-title">Find your <span class="accent-coral">people.</span></h1>
      <p class="org-sub">Associations, churches, Ugandan food and the people behind them. Starting in Greater Boston, plus the organizations that bring Ugandans together across North America.</p>
    </div>
  </section>

  <section class="shell org-body">
    <div class="org-toolbar">
      <label class="org-search">
        <%- icon('search', 16) %>
        <input type="search" placeholder="Search organizations..." data-org-search aria-label="Search organizations">
      </label>
      <% if (dir.states.length > 1) { %>
      <label class="org-loc"><span class="sr-only">Location</span>
        <select data-org-state aria-label="Location">
          <option value="all">All locations</option>
          <% dir.states.forEach(st => { %><option value="<%= st %>"><%= STATES[st] || st %></option><% }) %>
        </select>
      </label>
      <% } %>
      <div class="org-pills" data-org-pills>
        <button class="org-pill is-on" data-cat="all">All</button>
        <% cats.forEach(([k, label]) => { %><button class="org-pill" data-cat="<%= k %>" id="<%= k %>"><%= label %></button><% }) %>
      </div>
    </div>

    <p class="org-label">Organizations</p>
    <div class="org-grid" data-org-grid>
      <% dir.listings.forEach((l, i) => { const img = (l.images || [])[0]; %>
        <article class="org-card c-<%= l.category %>" data-cat="<%= l.category %>" data-state="<%= l.state %>" data-text="<%= (l.name + ' ' + l.location + ' ' + (STATES[l.state] || '') + ' ' + l.description).toLowerCase() %>">
          <button class="org-img" type="button" data-open="<%= i %>" aria-label="View <%= l.name %>">
            <% if (img) { %><img src="<%= img %>" alt="" loading="lazy" onerror="this.remove()"><% } %>
            <span class="org-town"><%= l.location %></span>
            <% if ((l.images || []).length > 1) { %><span class="org-count"><%= l.images.length %> photos</span><% } %>
          </button>
          <div class="org-info">
            <span class="org-cat"><%= CAT[l.category] %></span>
            <h3><%= l.name %></h3>
            <p class="org-where"><%= l.address ? l.address + ', ' + l.location : l.location %></p>
            <p class="org-desc"><%= l.description %></p>
            <div class="org-foot">
              <span class="org-status <%= l.verified ? 'ok' : '' %>"><%= l.verified ? 'Confirmed' : 'Details being confirmed' %></span>
              <button class="org-view" type="button" data-open="<%= i %>">View</button>
            </div>
          </div>
        </article>
      <% }) %>
    </div>
    <div class="org-empty" data-org-empty hidden>
      <h3>No match yet.</h3>
      <p>Know a group, church or Ugandan business that should be here? <a class="text-link" href="/submit/listing">Add it</a> and we'll add it.</p>
    </div>

    <div class="org-add">
      <div>
        <h2>Run an association, church or Ugandan business?</h2>
        <p>Get listed for free. Already listed? <a class="text-link" href="/submit/update">Update your details</a>.</p>
      </div>
      <a class="btn btn-primary" href="/submit/listing">Get listed <span class="arrow-circle"><%- icon('arrow', 15) %></span></a>
    </div>
  </section>

  <section class="join-strip-wrap">
    <div class="shell join-strip">
      <div><h2>NEW HERE? DON'T BE A STRANGER.</h2><p>Join the community and we'll let you know when the next gathering is on.</p></div>
      <a class="btn btn-primary" href="/join">Join the community <span class="arrow-circle"><%- icon('arrow', 15) %></span></a>
    </div>
  </section>
</main>

<!-- Organization profile popup -->
<dialog class="org-modal" data-org-modal aria-labelledby="om-title">
  <button class="om-close" type="button" data-close aria-label="Close">×</button>
  <div class="om-gallery">
    <div class="om-main"><img data-om-main alt=""></div>
    <div class="om-thumbs" data-om-thumbs></div>
    <p class="om-photo-note" data-om-note hidden>Representative photos. Send us real ones and we'll swap them in.</p>
  </div>
  <div class="om-body">
    <span class="org-cat" data-om-cat></span>
    <h2 id="om-title" data-om-name></h2>
    <p class="om-desc" data-om-desc></p>
    <ul class="om-rows">
      <li data-om-meets-row><span class="om-lbl">Meets / opens</span><strong data-om-meets></strong></li>
      <li data-om-addr-row><span class="om-lbl">Address</span><strong data-om-addr></strong><a class="om-btn" data-om-map target="_blank" rel="noopener"><%- icon('pin', 15) %>Open in Maps</a></li>
      <li data-om-phone-row><span class="om-lbl">Phone</span><a class="om-btn" data-om-phone-link><%- icon('phone', 15) %><span data-om-phone></span></a></li>
      <li data-om-web-row><span class="om-lbl">Website</span><a class="om-btn" data-om-web-link target="_blank" rel="noopener"><%- icon('globe', 15) %><span data-om-web></span></a></li>
    </ul>
    <a class="om-update" data-om-update>Is this yours? Update the details</a>
  </div>
</dialog>

<script type="application/json" id="org-data"><%- JSON.stringify(dir.listings.map(l => ({
  name: l.name, cat: CAT[l.category], town: l.location, description: l.description,
  address: l.fullAddress, meets: l.meets || '', phone: l.phone, website: l.website, images: (l.images || []).slice(0, 4),
  representative: !!l.photosRepresentative, map: l.mapLink,
  update: '/submit/update?org=' + encodeURIComponent(l.id || '')
}))).replace(/</g, '\\u003c') %></script>
<%- include('partials/footer') %>
