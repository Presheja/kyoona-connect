<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="robots" content="noindex">
  <title><%= typeof title !== 'undefined' ? title + ' · ' : '' %>Kyoona Connect Admin</title>
  <link rel="icon" href="/icons/favicon.ico" sizes="any">
  <link rel="stylesheet" href="/css/admin.css?v=4">
  <script src="/js/admin.js?v=1" defer></script>
</head>
<body class="adm">
<aside class="adm-side" id="adm-side">
  <a class="adm-brand" href="/admin"><span class="b1">KYO<span class="fl">✺</span>NA</span><span class="b2">ADMIN</span></a>
  <nav class="adm-nav">
    <% pages.forEach(p => { %>
      <% if (p.soon) { %>
        <span class="adm-link soon" title="Coming in a later stage"><%- icon(p.icon, 18) %><span><%= p.label %></span><em>Later</em></span>
      <% } else { %>
        <a class="adm-link <%= active === p.key ? 'on' : '' %>" href="<%= p.href %>"><%- icon(p.icon, 18) %><span><%= p.label %></span><% if (p.badge && badges && badges[p.badge]) { %><b class="badge"><%= badges[p.badge] %></b><% } %></a>
      <% } %>
    <% }) %>
  </nav>
  <div class="adm-side-foot">
    <a class="adm-link" href="/" target="_blank"><%- icon('external', 18) %><span>View site</span></a>
    <form method="post" action="/admin/logout"><button class="adm-link" type="submit"><%- icon('logout', 18) %><span>Log out</span></button></form>
  </div>
</aside>
<div class="adm-main">
  <header class="adm-top">
    <button class="adm-menu" type="button" data-menu aria-label="Menu"><%- icon('menu', 20) %></button>
    <div><h1><%= title %></h1><% if (typeof subtitle !== 'undefined' && subtitle) { %><p><%= subtitle %></p><% } %></div>
    <div class="adm-top-actions"><%- typeof actions !== 'undefined' ? actions : '' %></div>
  </header>
  <% if (flash) { %><div class="adm-flash ok"><%- icon('check', 16) %><%= flash %></div><% } %>
  <% if (flashError) { %><div class="adm-flash err"><%= flashError %></div><% } %>
